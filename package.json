{
  "name": "daur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:app": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && tsx scripts/clean-e2e.ts",
    "clean:e2e": "tsx scripts/clean-e2e.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:db": "tsx scripts/check-db-constraints.ts",
    "verify": "npm run type-check && npm run lint && npm run check:design && npm run check:contrast && npm run test",
    "seed:events": "tsx scripts/seed-events.ts",
    "event:status": "tsx scripts/event-status.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22 <23 || >=24"
  }
}
