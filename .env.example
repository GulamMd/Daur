# ---------------------------------------------------------------------------
# Daur — copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# Never commit the filled-in versions.
# ---------------------------------------------------------------------------

# Neon Postgres. Get both from the Neon dashboard > Connection Details.
# DATABASE_URL must be the POOLED string (contains "-pooler").
# DIRECT_URL must be the DIRECT string — migrations cannot use the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/daur?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/daur?sslmode=require"

# Auth.js (Phase 1). Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (Phase 1). Redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public site URL — used for absolute OG image URLs on event pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
